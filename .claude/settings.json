{
  "permissions": {
    "allow": [
      "mcp__github__create_pull_request",
      "mcp__github__merge_pull_request"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/conferir_edicao.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
