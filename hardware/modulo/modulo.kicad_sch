  (text "Módulo genérico do painel" (at 20.32 17.78 0)
    (effects (font (size 3 3) bold) (justify left top)) (uuid 99169515-9915-4f5b-9019-0a797ce4366c))
  (text "Todos os módulos usam esta mesma placa, com todos os CIs montados:\n24 entradas e 16 saídas para LED por módulo. Entrada ou saída sem uso fica livre." (at 20.32 25.4 0)
    (effects (font (size 1.27 1.27)) (justify left top)) (uuid 98fadb6a-905c-417b-87f8-7f64e60b5d02))
  (text "Entradas (74HC165)" (at 78.74 30.48 0)
    (effects (font (size 2 2) bold) (justify left top)) (uuid 5044226f-7c4a-4fad-ba18-d874a03074ee))
  (text "Saídas para LED (74HC595)" (at 78.74 180.34 0)
    (effects (font (size 2 2) bold) (justify left top)) (uuid ef83fe28-0f50-4f2a-9bfe-102c073406a7))
  (text "Desacoplamento: um 100nF colado em cada CI" (at 20.32 238.76 0)
    (effects (font (size 1.5 1.5) bold) (justify left top)) (uuid 3c33b564-0b25-4500-bd4f-fd2916cf7f7a))
  (text "Cabo flat (J1)\n 1  +5V        2  GND\n 3  SCK        4  GND\n 5  PL         6  RCLK\n 7  SIN165     8  SOUT165\n 9  SIN595    10  SOUT595\n11  AN_A      12  GND\n13  AN_B      14  AN_C\n15  +5V       16  GND" (at 20.32 121.92 0)
    (effects (font (size 1.27 1.27)) (justify left top)) (uuid 6e12391a-4716-44c4-82f7-c6f73190d189))
  (text "Cadeia de entradas: SIN165 > U3 > U2 > U1 > SOUT165 (para o Mega).\nO Mega lê primeiro U1 (IN0-7), depois U2 (IN8-15), depois U3 (IN16-23).\nBotão ou chave: entre INn e GND. Apertado/ligado = 0 (pull-up de 10k).\n\nCadeia de saídas: SIN595 > U4 > U5 > SOUT595 (para o próximo slot).\nLED: anodo em LEDn, catodo no GND. 1k limita a corrente a uns 3 mA,\npara os 8 LEDs de um 74HC595 ficarem abaixo de 70 mA." (at 20.32 160.02 0)
    (effects (font (size 1.27 1.27)) (justify left top)) (uuid 271c78df-cd3b-4def-b18e-96602630f0f2))

  (sheet_instances
    (path "/" (page "1"))
